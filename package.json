{
  "name": "songying-prototype-bakeoff",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "map:fetch": "python3 scripts/geo/fetch.py",
    "map:data": "python3 scripts/geo/normalize.py && node --experimental-strip-types scripts/geo/process.mjs",
    "map:test": "node --experimental-strip-types --test scripts/geo/geo.test.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
